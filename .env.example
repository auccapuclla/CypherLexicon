# Anthropic API Key for running agent translations
# Copy this file to .env and replace with your actual API key
ANTHROPIC_API_KEY=your_key_here

# PostgreSQL DB credentials (used by Docker Compose & Node app)
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here
DB_HOST=localhost
DB_PORT=5432

# (Optional) Direct connection string override
# DATABASE_URL=postgresql://your_db_user_here:your_db_password_here@localhost:5432/your_db_name_here
